PORT=3000
ACCESS_TOKEN_SECRET=super_secret_access_key_change_me_in_production_2024
REFRESH_TOKEN_SECRET=super_secret_refresh_key_change_me_in_production_2024
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ----------------------------------------------------------------------
# 1-USUL (Eng osoni): Google Gmail App Password (1 daqiqa vaqt oladi)
# ----------------------------------------------------------------------
# 1. https://myaccount.google.com/security ga kiring va 2-Step Verification ni yoqing
# 2. https://myaccount.google.com/apppasswords ga kirib 16 xonali parol yarating
# 3. Quyidagi qatorlarni to'ldiring:
# EMAIL_USER=sizning_pochtangiz@gmail.com
# EMAIL_PASS=xxxx xxxx xxxx xxxx

# ----------------------------------------------------------------------
# 2-USUL: Google Cloud Console (OAuth 2.0 Client ID)
# ----------------------------------------------------------------------
# 1. https://console.cloud.google.com ga kiring va yangi loyiha oching
# 2. APIs & Services -> Library -> "Gmail API" ni yoqing (Enable)
# 3. OAuth consent screen sozlang (External)
# 4. Credentials -> Create Credentials -> OAuth client ID (Web application)
# 5. https://developers.google.com/oauthplayground orqali Refresh Token oling
# EMAIL_USER=sizning_pochtangiz@gmail.com
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token
